{
  "name": "nexchat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of fs.readdirSync('.')){if(/\\.(html|webmanifest|png)$/.test(f)||f==='sw.js')fs.copyFileSync(f,'www/'+f)}\""
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}